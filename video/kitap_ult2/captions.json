[
 {
  "id": "c01",
  "t": 1,
  "sub": "Бауыржан Момышұлының **«Ұшқан ұя»** повесі —"
 },
 {
  "id": "c02",
  "t": 5,
  "sub": "қазақ әдебиетіндегі **тәрбие**,"
 },
 {
  "id": "c03",
  "t": 7,
  "sub": "**отбасы**,"
 },
 {
  "id": "c04",
  "t": 8,
  "sub": "**ұлт тағдыры** туралы терең мағыналы шығармалардың бірі."
 },
 {
  "id": "c05",
  "t": 11,
  "sub": "Автор өзінің **балалық шағын**, ата-әжесінің"
 },
 {
  "id": "c06",
  "t": 14,
  "sub": "**тәрбиесін**,"
 },
 {
  "id": "c07",
  "t": 15,
  "sub": "**ауыл өмірін** шынайы сүйіспеншілікпен суреттейді."
 },
 {
  "id": "c08",
  "t": 20,
  "sub": "Шығарманың **негізгі идеясы** —"
 },
 {
  "id": "c09",
  "t": 22,
  "sub": "адамның болашағы **ұядан** бастау алады."
 },
 {
  "id": "c10",
  "t": 26,
  "sub": "Бауыржанның тұлға болып қалыптасуына әжесі **Қызтумас**,"
 },
 {
  "id": "c11",
  "t": 29,
  "sub": "атасы **Иманәлі**,"
 },
 {
  "id": "c12",
  "t": 31,
  "sub": "әкесі **Момыштың** ықпалы зор."
 },
 {
  "id": "c13",
  "t": 34,
  "sub": "Әжесінің **ертегісі мен өсиеті**,"
 },
 {
  "id": "c14",
  "t": 37,
  "sub": "атасының **әділ талабы**"
 },
 {
  "id": "c15",
  "t": 39,
  "sub": "болашақ батырдың бойында **отансүйгіштік**,"
 },
 {
  "id": "c16",
  "t": 42,
  "sub": "**еңбекқорлық**, **табандылық** қасиеттерін қалыптастырады."
 },
 {
  "id": "c17",
  "t": 47,
  "sub": "Автор ауылдың **салт-дәстүрін**,"
 },
 {
  "id": "c18",
  "t": 50,
  "sub": "қазақтың **қонақжайлылығы** мен **үлкенге құрметін**"
 },
 {
  "id": "c19",
  "t": 54,
  "sub": "шынайы суреттейді."
 },
 {
  "id": "c20",
  "t": 55,
  "sub": "Әсіресе бала Бауыржанның **жайлауға** шығуы,"
 },
 {
  "id": "c21",
  "t": 59,
  "sub": "**мектепке** баруы,"
 },
 {
  "id": "c22",
  "t": 61,
  "sub": "**алғашқы қиындықпен** бетпе-бет келуі"
 },
 {
  "id": "c23",
  "t": 64,
  "sub": "оқырманды бей-жай қалдырмайды."
 },
 {
  "id": "c24",
  "t": 67,
  "sub": "Осы арқылы біз сол кездегі қазақ"
 },
 {
  "id": "c25",
  "t": 69,
  "sub": "ауылдарының **тұрмыс-тіршілігін**"
 },
 {
  "id": "c26",
  "t": 71,
  "sub": "және **бала тәрбиесіндегі** ерекшеліктерін байқай аламыз."
 },
 {
  "id": "c27",
  "t": 75,
  "sub": "Шығарманың тілі **қарапайым**,"
 },
 {
  "id": "c28",
  "t": 76,
  "sub": "бірақ **терең мағыналы**."
 },
 {
  "id": "c29",
  "t": 78,
  "sub": "Бауыржан әрбір оқиғасы арқылы"
 },
 {
  "id": "c30",
  "t": 81,
  "sub": "бізге **өмірлік сабақ** береді."
 },
 {
  "id": "c31",
  "t": 84,
  "sub": "Негізгі"
 },
 {
  "id": "c32",
  "t": 85,
  "sub": "өзекті ұғым — **бала тәрбиесі**."
 },
 {
  "id": "c33",
  "t": 88,
  "sub": "Бұл — **ұлт тәрбиесі** деген ұғымды білдіреді."
 },
 {
  "id": "c34",
  "t": 93,
  "sub": "Шығарманы оқу арқылы мен"
 },
 {
  "id": "c35",
  "t": 97,
  "sub": "бұл тек қана **бір баланың** тағдыры емес,"
 },
 {
  "id": "c36",
  "t": 99,
  "sub": "**бүкіл ұлттың** тағдыры туралы жазылғанын түсіндім."
 },
 {
  "id": "c37",
  "t": 102,
  "sub": "Мұны оқу арқылы жастар **отансүйгіштікке**,"
 },
 {
  "id": "c38",
  "t": 106,
  "sub": "**ата-ананы құрметтеуге** және қиындыққа"
 },
 {
  "id": "c39",
  "t": 109,
  "sub": "**мойымауға** үйренеді."
 },
 {
  "id": "c40",
  "t": 111,
  "sub": "Кітапты оқыған **әрбір азамат**"
 },
 {
  "id": "c41",
  "t": 114,
  "sub": "өзінің **өскен ұясын**,"
 },
 {
  "id": "c42",
  "t": 115,
  "sub": "**балалық шағын** еске түсіреді."
 }
]