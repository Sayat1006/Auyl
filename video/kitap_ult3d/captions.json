[
 {"id":"c01","t":1,"sub":"Роман Мухтара Ауэзова **«Путь Абая»**"},
 {"id":"c02","t":4,"sub":"— это **шедевр** казахской литературы,"},
 {"id":"c03","t":7,"sub":"который глубоко раскрывает **историю и душу** народа"},
 {"id":"c04","t":11,"sub":"через жизнь **великого поэта**."},
 {"id":"c05","t":14,"sub":"В **первом томе** мы видим становление юного Абая."},
 {"id":"c06","t":19,"sub":"Автор показывает его возвращение в **родной аул**,"},
 {"id":"c07","t":22,"sub":"**взросление**,"},
 {"id":"c08","t":24,"sub":"столкновение с **суровой реальностью** степной жизни."},
 {"id":"c09","t":28,"sub":"Перед читателем разворачивается **масштабная картина**"},
 {"id":"c10","t":32,"sub":"казахского общества"},
 {"id":"c11","t":34,"sub":"**XIX века** с его традициями,"},
 {"id":"c12","t":37,"sub":"внутренними **конфликтами** и **несправедливостью**."},
 {"id":"c13","t":42,"sub":"Особенно впечатляет **глубина характера** Абая,"},
 {"id":"c14","t":46,"sub":"который ищет **правду** и служит своему народу."},
 {"id":"c15","t":50,"sub":"Язык романа невероятно **поэтичен** и богат."},
 {"id":"c16","t":55,"sub":"Это не просто **биография**,"},
 {"id":"c17","t":56,"sub":"а настоящая **энциклопедия** степной жизни,"},
 {"id":"c18","t":61,"sub":"которая оставляет **сильный след**"},
 {"id":"c19","t":63,"sub":"в сердце **каждого читателя**."}
]
